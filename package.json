{
  "name": "healix-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:desktop": "pnpm --filter @healix/desktop dev",
    "build:desktop": "pnpm --filter @healix/desktop build",
    "doctor": "pnpm --filter @healix/core build && pnpm --filter @healix/cli build && node packages/cli/dist/index.js doctor",
    "healix": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
