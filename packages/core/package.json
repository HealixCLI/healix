{
  "name": "@healix/core",
  "version": "0.0.0",
  "description": "Healix shared core — orchestrator, AI providers, storage, test modes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.4",
    "@babel/types": "^7.26.3",
    "archiver": "^7.0.1",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.0.9",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/babel__traverse": "^7.20.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
